{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KlikVibe",
  "version": "0.3.2",
  "identifier": "com.ashafizullah.klikvibe",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1424",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KlikVibe",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#15130f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' data: blob: media: http://media.localhost; media-src media: http://media.localhost; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src media: http://media.localhost http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Free, open-source, lightweight code editor for vibe coding",
    "longDescription": "See the code your AI agent writes, follow Git changes, history and pushes, and run the agent in a built-in terminal, all in one small, fast window.",
    "copyright": "Copyright © 2026 Adam Suchi Hafizullah. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "dmg": {
        "background": "installer/dmg-background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 210 },
        "applicationFolderPosition": { "x": 480, "y": 210 }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "publisher": "KlikVibe contributors",
    "homepage": "https://github.com/ashafizullah/klikvibe",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwRTU2QzMxQkJCOEFFQTgKUldTb3JyaTdNV3psQUJZUVROSlFFcS9jbE9PVi9RMEJYbnJ4UHFSeGVQSXRCTHBVT2x6VUhUUEcK",
      "endpoints": [
        "https://github.com/ashafizullah/klikvibe/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
